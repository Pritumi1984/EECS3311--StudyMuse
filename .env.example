# .env.example - contains no real credentials.
# Copy this file to ".env" (same folder) and put your own key in .env.
# .env is listed in .gitignore, so it is never pushed to GitHub.

# Which LLM to use: gemini | claude | mock   (mock = offline practice mode, no key needed)
LLM_PROVIDER=gemini
LLM_API_KEY=YOUR_LOCAL_API_KEY_HERE
# Model name for the chosen provider (Gemini default shown)
LLM_MODEL=gemini-2.5-flash

# Where StudyMuse stores courses (created automatically)
DATA_DIR=data
