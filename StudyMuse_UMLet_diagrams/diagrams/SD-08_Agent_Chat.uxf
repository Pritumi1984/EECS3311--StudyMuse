<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<diagram program="umlet" version="15.1">
  <zoom_level>10</zoom_level>
  <element>
    <id>UMLSequenceAllInOne</id>
    <coordinates>
      <x>0</x>
      <y>0</y>
      <w>3520</w>
      <h>1970</h>
    </coordinates>
    <panel_attributes>title=SD-08  Agent Chat: Multi-Step Tool Loop with Memory (UC12 / F12)
obj=Student~s ACTOR
obj=:MainWindow~mw
obj=:StudyAgentController\n«Facade»~c
obj=:AgentPlanner~ap
obj=:MemoryManager~mm
obj=:PromptBuilder\n«Builder»~pb
obj=:LLMClient~llm
obj=«external»\nLLM Service~ext
obj=:ResponseParser~rp
obj=:ToolRegistry~tr
obj=:StudyTool~tool

s-&gt;&gt;&gt;mw : Quiz me on my weakest topic\nand add mistakes to flashcards
mw-&gt;&gt;&gt;c : chat(courseId, message)
c-&gt;&gt;&gt;ap : run(courseId, request)
ap-&gt;&gt;&gt;mm : getRelevantContext(request)
mm.&gt;ap : recent messages + facts (e.g. exam date)
combinedFragment=loop~l1; ap:[until FINAL_ANSWER or 10\nsteps]
ap-&gt;&gt;&gt;pb : withMemory(context).withTools(tool list)\n.withUserRequest(request).build()
pb.&gt;ap : Prompt
ap-&gt;&gt;&gt;ap + : decideNext\nAction(ctx)
tick=
ap-&gt;&gt;&gt;llm : complete(prompt)
llm-&gt;&gt;&gt;ext : send via LLMProvider
ext.&gt;llm : action JSON
llm.&gt;ap : raw text
ap-&gt;&gt;&gt;rp : parseAction(raw)
rp.&gt;ap : AgentAction
combinedFragment=alt~a1; ap:[TOOL_CALL]
ap-&gt;&gt;&gt;rp : validateToolCall(action, registry)
rp.&gt;ap : ValidationResult
combinedFragment=alt~a2; rp:[valid]
ap-&gt;&gt;&gt;tr : execute(name, args)
tr-&gt;&gt;&gt;tool : execute(args)  e.g. GetWeakTopicsTool, GenerateQuizTool
tool.&gt;tr : ToolResult
tr.&gt;ap : ToolResult
ap-&gt;&gt;&gt;ap + : ctx.addStep\n(step)
tick=
..=a2; rp:[unknown tool or bad args]
ap-&gt;&gt;&gt;ap + : ctx.addStep\n(error), fed\nback to LLM
tick=
--=a2
..=a1; ap:[ASK_CLARIFICATION]
ap.&gt;c : question
c.&gt;mw : question
mw.&gt;s : Which course?
..=a1; ap:[FINAL_ANSWER]
ap-&gt;&gt;&gt;ap + : exit loop
tick=
--=a1
--=l1
ap-&gt;&gt;&gt;mm : addMessage(m), rememberFact(key, value)
ap.&gt;c : AgentResponse(answer, steps)
c.&gt;mw : AgentResponse
mw.&gt;s : final answer + tool name and result per step</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
</diagram>
