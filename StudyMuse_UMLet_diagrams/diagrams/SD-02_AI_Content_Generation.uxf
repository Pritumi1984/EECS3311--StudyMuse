<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<diagram program="umlet" version="15.1">
  <zoom_level>10</zoom_level>
  <element>
    <id>UMLSequenceAllInOne</id>
    <coordinates>
      <x>0</x>
      <y>0</y>
      <w>3050</w>
      <h>1470</h>
    </coordinates>
    <panel_attributes>title=SD-02  AI Content Generation: Summarize / Concepts / Flashcards / Quiz (UC02, UC04, UC05, UC07)
obj=Student~s ACTOR
obj=:MainWindow~mw
obj=:StudyAgentController\n«Facade»~c
obj=:MaterialAnalysisService~mas
obj=:PromptBuilder\n«Builder»~pb
obj=:LLMClient~llm
obj=:LLMProvider\n«Strategy»~prov
obj=«external»\nLLM Service~ext
obj=:ResponseParser~rp
obj=:CourseRepository~repo

s-&gt;&gt;&gt;mw : click Summarize (length = short)
mw-&gt;&gt;&gt;c : summarize(materialId, length)
c-&gt;&gt;&gt;mas : summarize(material, length)
mas-&gt;&gt;&gt;pb : withSystemInstructions(length rule)\n.withContext(chunks)\n.withOutputFormat(schema).build()
pb.&gt;mas : Prompt
mas-&gt;&gt;&gt;llm : complete(prompt)
llm-&gt;&gt;&gt;prov : send(prompt)
prov-&gt;&gt;&gt;ext : HTTPS request
combinedFragment=alt~a1; ext:[response received]
ext.&gt;prov : JSON text
prov.&gt;llm : LLMResponse
llm.&gt;mas : text
mas-&gt;&gt;&gt;rp : parseJson(text, Summary.class)
combinedFragment=alt~a2; rp:[valid JSON]
rp.&gt;mas : Summary
mas-&gt;&gt;&gt;repo : saveMaterial(courseId, material)
mas.&gt;c : Summary
c.&gt;mw : Summary
mw.&gt;s : show in reading panel
..=a2; rp:[malformed JSON]
rp.&gt;mas : parse error
mas-&gt;&gt;&gt;llm : complete(prompt + format reminder)  (one retry)
mas.&gt;c : error if still invalid
c.&gt;mw : error
mw.&gt;s : show error message
--=a2
..=a1; prov:[timeout after 2 retries\n(RetryingProvider)]
prov.&gt;llm : failure
llm.&gt;mas : LLM unavailable
mas.&gt;c : error, material unchanged
c.&gt;mw : error
mw.&gt;s : show error message
--=a1</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
  <element>
    <id>UMLNote</id>
    <coordinates>
      <x>20</x>
      <y>1490</y>
      <w>760</w>
      <h>90</h>
    </coordinates>
    <panel_attributes>Same interaction structure for F04, F05 and F07. Only the service, prompt template
and output schema change: MaterialAnalysisService.extractConcepts(material) -&gt; List&lt;Concept&gt;,
FlashcardService.generate(sourceId, count) -&gt; Deck (saveDeck),
QuizService.generate(request) -&gt; Quiz (saveCourse).
bg=#FFFFE0</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
</diagram>
