    <panel_attributes>title=SD-03  Question Answering with Retrieval (UC03 / F03)
obj=Student~s ACTOR
obj=:MainWindow~mw
obj=:StudyAgentController\n«Facade»~c
obj=:QAService~qa
obj=:SearchIndex~ix
obj=:PromptBuilder\n«Builder»~pb
obj=:LLMClient~llm
obj=«external»\nLLM Service~ext
obj=:ResponseParser~rp

s-&gt;&gt;&gt;mw : type a question, click Ask
mw-&gt;&gt;&gt;c : askQuestion(courseId, question)
c-&gt;&gt;&gt;qa : answer(courseId, question)
qa-&gt;&gt;&gt;ix : search(courseId, question, 5)
ix.&gt;qa : top 5 chunks
combinedFragment=alt~a1; ix:[relevant chunks found]
qa-&gt;&gt;&gt;pb : withSystemInstructions(answer ONLY from chunks, cite ids)\n.withContext(chunks).withUserRequest(question).build()
pb.&gt;qa : Prompt
qa-&gt;&gt;&gt;llm : complete(prompt)
llm-&gt;&gt;&gt;ext : send via LLMProvider
ext.&gt;llm : answer text
llm.&gt;qa : answer text
qa-&gt;&gt;&gt;rp : validateCitations(answer, chunks)
rp.&gt;qa : Answer (unknown citations removed, flagged)
qa.&gt;c : Answer
c.&gt;mw : Answer
mw.&gt;s : answer + material / chunk references
..=a1; ix:[no relevant chunks]
qa.&gt;c : Answer: materials do not cover this
c.&gt;mw : Answer
mw.&gt;s : LLM is never asked to guess
--=a1</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
