    <panel_attributes>title=SD-07  Study Plan Generation with Validation Loop (UC10 / F10)
obj=Student~s ACTOR
obj=:MainWindow~mw
obj=:StudyAgentController\n«Facade»~c
obj=:AnalyticsService~an
obj=:StudyPlanService~sp
obj=:PromptBuilder\n«Builder»~pb
obj=:LLMClient~llm
obj=«external»\nLLM Service~ext
obj=:ResponseParser~rp
obj=:PlanValidator~pv
obj=:CourseRepository~repo

s-&gt;&gt;&gt;mw : enter exam date, hours per day, topics
mw-&gt;&gt;&gt;c : generatePlan(request)
combinedFragment=alt~a1; c:[exam date in the past]
c.&gt;mw : error
mw.&gt;s : request rejected
..=a1; c:[valid request]
c-&gt;&gt;&gt;an : findWeakTopics(courseId)
an.&gt;c : weakTopics
c-&gt;&gt;&gt;sp : generatePlan(request, weakTopics)
sp-&gt;&gt;&gt;pb : withContext(concepts + weak topics)\n.withOutputFormat(plan schema).build()
pb.&gt;sp : Prompt
sp-&gt;&gt;&gt;llm : complete(prompt)
llm-&gt;&gt;&gt;ext : send via LLMProvider
ext.&gt;llm : draft plan (JSON)
llm.&gt;sp : draft plan
sp-&gt;&gt;&gt;rp : parseJson(draft, StudyPlan.class)
rp.&gt;sp : StudyPlan
sp-&gt;&gt;&gt;pv : validate(plan, request)
pv.&gt;sp : problems (hours, missing topic, late date)
combinedFragment=loop~l1; sp:[problems found, max 2\nattempts]
sp-&gt;&gt;&gt;llm : complete(fix these problems)
llm.&gt;sp : revised plan
sp-&gt;&gt;&gt;rp : parseJson(revised, StudyPlan.class)
sp-&gt;&gt;&gt;pv : validate(plan, request)
pv.&gt;sp : problems
--=l1
combinedFragment=opt~o1; sp:[still invalid]
sp-&gt;&gt;&gt;sp + : createFallback\nPlan(request)\nequal time\nper topic
tick=
--=o1
sp-&gt;&gt;&gt;repo : savePlan(plan)
sp.&gt;c : StudyPlan
c.&gt;mw : StudyPlan
mw.&gt;s : calendar view (weak topics prioritized)
--=a1</panel_attributes>
